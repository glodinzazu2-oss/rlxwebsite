---
/**
 * En-tête de section standardisé : eyebrow + titre (multi-lignes via \n).
 * Le titre se dévoile ligne par ligne au scroll (masque + translation),
 * piloté par animations/titleReveal.ts. Garantit une hiérarchie identique partout.
 */
interface Props {
  eyebrow: string;
  title: string;
  align?: 'left' | 'center';
  level?: 'h2' | 'h3';
  /** id du titre — à référencer par aria-labelledby sur la <section> parente */
  titleId?: string;
}

const { eyebrow, title, align = 'left', level: Tag = 'h2', titleId } = Astro.props;
const lines = title.split('\n');
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <p class="eyebrow" data-reveal>{eyebrow}</p>
  <Tag class="section-heading__title" id={titleId} data-reveal-lines>
    {
      lines.map((line) => (
        <span class="section-heading__line">
          <span class="section-heading__line-inner">{line}</span>
        </span>
      ))
    }
  </Tag>
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-4);
    max-width: 44ch;
    margin-bottom: var(--space-12);
  }

  .section-heading--center {
    justify-items: center;
    text-align: center;
  }

  /* Chaque ligne est un masque ; l'intérieur monte de sous le masque au scroll. */
  .section-heading__line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }
  .section-heading__line-inner {
    display: block;
  }

  /* État initial (JS actif) : ligne cachée sous le masque, sans flash. */
  :global(html.js) [data-reveal-lines] .section-heading__line-inner {
    transform: translateY(110%);
  }
</style>
