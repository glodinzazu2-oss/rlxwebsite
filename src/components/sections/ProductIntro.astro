---
import { getDictionary } from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';

const t = getDictionary();
const kit = t.product.kit;
---

<section class="section product" id="produit" aria-labelledby="produit-title" data-glow-zone>
  <span class="product__ambient" data-reactive-glow aria-hidden="true"></span>

  <div class="container product__inner">
    <SectionHeading eyebrow={t.product.eyebrow} title={t.product.title} titleId="produit-title" />
    <p class="product__body" data-reveal data-reveal-delay="0.1">{t.product.body}</p>

    <div class="product__manifest">
      <p class="product__manifest-label" data-reveal data-reveal-delay="0.15">
        {t.product.kitLabel}
      </p>
      <ul class="manifest" role="list">
        {
          kit.map((item, i) => (
            <li class="manifest__item" data-reveal data-reveal-delay={0.2 + i * 0.06}>
              <span class="manifest__node" aria-hidden="true" />
              <div class="manifest__text">
                <p class="manifest__name">
                  {item.name}
                  <span class="manifest__qty">×{item.qty}</span>
                </p>
                <p class="manifest__desc">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .product {
    position: relative;
    overflow: clip;
    isolation: isolate;
  }

  /* Halo ambiant réactif : suit le curseur (variables --gx/--gy posées par reactiveGlow). */
  .product__ambient {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      36% 42% at var(--gx, 62%) var(--gy, 36%),
      rgba(255, 30, 45, 0.1),
      transparent 70%
    );
    animation: product-glow-breathe 6s var(--ease-in-out-soft) infinite;
  }

  .product__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-8);
  }

  .product__body {
    max-width: 58ch;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .product__manifest {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-6);
  }

  .product__manifest-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .manifest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(var(--space-8), 5vw, var(--space-16));
    max-width: 62rem;
  }

  .manifest__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  /* Nœud LED : point rouge qui « vit » (halo pulsé, GPU only). */
  .manifest__node {
    position: relative;
    flex: none;
    width: 11px;
    height: 11px;
    margin-top: 0.45em;
    border-radius: var(--radius-full);
    background: var(--color-led-red);
    box-shadow:
      0 0 0 4px rgba(255, 30, 45, 0.12),
      0 0 12px rgba(255, 30, 45, 0.6);
  }
  .manifest__node::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 2px rgba(255, 30, 45, 0.5);
    animation: manifest-pulse 2.8s var(--ease-out-quart) infinite;
  }

  .manifest__name {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .manifest__qty {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-led-red);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .manifest__desc {
    margin-top: var(--space-2);
    max-width: 44ch;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .manifest__node {
    transition: box-shadow var(--duration-base) var(--ease-out-quart);
  }
  @media (hover: hover) {
    .manifest__item:hover .manifest__node {
      box-shadow:
        0 0 0 4px rgba(255, 30, 45, 0.16),
        0 0 20px rgba(255, 30, 45, 0.85);
    }
  }

  @keyframes product-glow-breathe {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes manifest-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .manifest {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__ambient,
    .manifest__node::after {
      animation: none;
    }
  }
</style>
