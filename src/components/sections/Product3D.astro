---
import { Picture } from 'astro:assets';
import { getDictionary } from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import fallbackImage from '../../assets/images/kit-complet-mallette.png';

// URLs des modèles résolues au build (hashées, mises en cache long).
import lightUrl from '../../assets/models/remolux-light.glb?url';
import transmitterUrl from '../../assets/models/remolux-transmitter.glb?url';
import toolboxUrl from '../../assets/models/remolux-toolbox.glb?url';

const t = getDictionary();
const p = t.product3d;

// Points d'intérêt du feu LED : ancrés en fractions [-1..1] des demi-dimensions
// (0 = centre, 1 = bord), avec leur normale sortante (masquage quand le point passe
// derrière l'objet). Libellés/textes issus de l'i18n. Éléments physiques réels
// uniquement (pas de mention IP67 : cf. décision claims du 24/07).
const lightHotspots = [
  { pos: [0, 0.12, 1], normal: [0, 0, 1], ...p.hotspots.light[0] }, // face LED
  { pos: [0, 0, -1], normal: [0, 0, -1], ...p.hotspots.light[1] }, // dos aimanté
  { pos: [1, -0.1, 0.15], normal: [1, 0, 0.2], ...p.hotspots.light[2] }, // flanc boîtier
];

// Émetteur (boîtier bas et allongé, face avant en +Z).
const transmitterHotspots = [
  { pos: [0, 0.15, 1], normal: [0, 0, 1], ...p.hotspots.transmitter[0] }, // connecteur (avant)
  { pos: [0, 1, -0.1], normal: [0, 1, 0], ...p.hotspots.transmitter[1] }, // liaison (dessus)
  { pos: [1, -0.1, -0.15], normal: [1, 0, -0.1], ...p.hotspots.transmitter[2] }, // flanc
];

// Mallette (panneau plat, grande face en +Z, poignée sur l'arête haute).
const toolboxHotspots = [
  { pos: [-0.25, 0, 1], normal: [0, 0, 1], ...p.hotspots.toolbox[0] }, // grande face
  { pos: [0, 1, 0.25], normal: [0, 0.7, 0.7], ...p.hotspots.toolbox[1] }, // poignée (arête haute)
  { pos: [0.45, -0.35, 1], normal: [0, 0, 1], ...p.hotspots.toolbox[2] }, // fermoirs
];

// Pose (angle de vue initial) + bornes de zoom par objet. La mallette est bridée
// en zoom (minZoomScale élevé) pour ne jamais exposer les petits marquages packaging.
const modelUrls = {
  // maxPolarDeg 80 : verrouille la bascule vers le bas bien avant la face
  // inférieure du feu (écriture d'usine jamais visible).
  light: {
    url: lightUrl,
    azimuthDeg: 22,
    polarDeg: 78,
    distanceScale: 1.5,
    maxZoomScale: 1.7,
    maxPolarDeg: 80,
    hotspots: lightHotspots,
  },
  transmitter: {
    url: transmitterUrl,
    azimuthDeg: 35,
    polarDeg: 76,
    distanceScale: 1.55,
    hotspots: transmitterHotspots,
  },
  toolbox: {
    url: toolboxUrl,
    azimuthDeg: 24,
    polarDeg: 74,
    distanceScale: 1.4,
    minZoomScale: 0.92,
    maxZoomScale: 1.4,
    hotspots: toolboxHotspots,
  },
};
---

<section class="section product3d" id="vue-3d" aria-labelledby="product3d-title">
  <div class="container product3d__inner">
    <SectionHeading eyebrow={p.eyebrow} title={p.title} titleId="product3d-title" align="center" />
    <p class="product3d__subtitle" data-reveal>{p.subtitle}</p>

    <div
      class="product3d__stage"
      data-viewer
      data-models={JSON.stringify(modelUrls)}
      data-reveal
      data-reveal-delay="0.1"
      role="region"
      aria-label={p.viewerAria}
    >
      <!-- Repli produit : porte l'alternative textuelle du produit (lue par les
           lecteurs d'écran dans tous les cas) ; visible seulement si WebGL absent. -->
      <div class="product3d__fallback" data-viewer-fallback>
        <Picture
          src={fallbackImage}
          formats={['avif', 'webp']}
          widths={[480, 860]}
          sizes="(min-width: 900px) 720px, 92vw"
          alt={p.fallbackAlt}
          loading="lazy"
        />
      </div>
      <p class="product3d__loading" data-viewer-loading aria-hidden="true" hidden>{p.loading}</p>
    </div>

    <div class="product3d__controls" role="group" aria-label={p.controlsAria}>
      {
        p.items.map((item, i) => (
          <button
            class="product3d__tab"
            type="button"
            data-model={item.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {item.label}
          </button>
        ))
      }
    </div>

    <!-- Annonce vocale du modèle sélectionné (invisible, lue par les lecteurs d'écran). -->
    <p
      class="visually-hidden"
      role="status"
      aria-live="polite"
      data-viewer-status
      data-suffix={p.announceSuffix}
    >
    </p>

    <p class="product3d__hint" aria-hidden="true">{p.hint}</p>
  </div>
</section>

<script>
  // Types seuls (effacés au build) : n'entraînent aucun chargement de three.js.
  import type { ModelKey, ModelConfig } from '../../webgl/createProductViewer';

  const stage = document.querySelector<HTMLElement>('[data-viewer]');
  if (stage) {
    const models = JSON.parse(stage.dataset.models ?? '{}') as Record<string, ModelConfig>;
    const loading = stage.querySelector<HTMLElement>('[data-viewer-loading]');
    const status = document.querySelector<HTMLElement>('[data-viewer-status]');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-model]'));

    // Annonce vocale : « <élément> affiché » à chaque sélection.
    const announce = (tab: HTMLButtonElement) => {
      if (status)
        status.textContent = `${tab.textContent?.trim()} ${status.dataset.suffix ?? ''}`.trim();
    };

    const webglOk = (() => {
      try {
        return !!document.createElement('canvas').getContext('webgl2');
      } catch {
        return false;
      }
    })();

    // WebGL indisponible : on affiche le repli produit (dégradation gracieuse).
    if (!webglOk) stage.classList.add('no-webgl');

    let booted = false;
    const boot = async () => {
      if (booted || !webglOk) return;
      booted = true;

      loading?.removeAttribute('hidden');
      // Import dynamique : three.js + le viewer ne sont téléchargés qu'ici (chunk séparé).
      const { createProductViewer } = await import('../../webgl/createProductViewer');

      // onReady : appelé dès que le 1er modèle est à l'écran.
      const viewer = createProductViewer(stage, models, () => {
        loading?.setAttribute('hidden', '');
        stage.classList.add('is-ready');
      });

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.dataset.model as ModelKey;
          tabs.forEach((other) => other.setAttribute('aria-pressed', String(other === tab)));
          viewer.setModel(key);
          announce(tab);
        });
      });

      viewer.setModel((tabs[0]?.dataset.model as ModelKey) ?? 'light');
    };

    // Chargement différé : on n'importe/instancie la 3D qu'à l'approche du viewport.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void boot();
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(stage);
  }
</script>

<style>
  .product3d {
    background:
      radial-gradient(50% 50% at 50% 30%, rgba(255, 30, 45, 0.05), transparent 70%), var(--color-bg);
  }

  .product3d__inner {
    display: grid;
    justify-items: center;
  }

  .product3d__subtitle {
    max-width: 46ch;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    margin-top: calc(-1 * var(--space-8));
    margin-bottom: var(--space-8);
  }

  .product3d__stage {
    position: relative;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 4 / 3;
    touch-action: pan-y; /* laisse le scroll vertical de page fonctionner sur mobile */
  }

  /* Halo doux sous l'objet pour l'ancrer sans le mettre en boîte. */
  .product3d__stage::before {
    content: '';
    position: absolute;
    inset: 12% 10% 8%;
    background: radial-gradient(60% 55% at 50% 55%, rgba(255, 30, 45, 0.06), transparent 72%);
    pointer-events: none;
  }

  .product3d__stage :global(canvas) {
    cursor: grab;
  }
  .product3d__stage :global(canvas):active {
    cursor: grabbing;
  }

  /* Repli produit : masqué par défaut, affiché uniquement si WebGL est absent
     (dégradation gracieuse). Pendant le chargement 3D, seul l'indicateur discret
     apparaît sur le stage transparent — pas de boîte. */
  .product3d__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out-quart);
  }

  .product3d__stage.no-webgl .product3d__fallback {
    opacity: 1;
  }

  .product3d__fallback :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product3d__loading {
    position: absolute;
    inset-inline: 0;
    bottom: var(--space-4);
    text-align: center;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .product3d__controls {
    display: flex;
    gap: var(--space-6);
    margin-top: var(--space-8);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Onglets texte épurés : discrets au repos, actif souligné d'un trait LED. */
  .product3d__tab {
    position: relative;
    padding: var(--space-2) 0;
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .product3d__tab::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-led-red);
    box-shadow: 0 0 8px rgba(255, 30, 45, 0.6);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  @media (hover: hover) {
    .product3d__tab:hover {
      color: var(--color-text-secondary);
    }
  }

  .product3d__tab[aria-pressed='true'] {
    color: var(--color-text);
  }

  .product3d__tab[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  .product3d__hint {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* --- Hotspots 3D : marqueurs créés en JS (styles globaux, portés au stage) --- */
  .product3d__stage :global(.product3d__hotspots) {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Cible tactile de 44px centrée sur le point projeté (le point visible est plus petit). */
  .product3d__stage :global(.product3d__hs) {
    position: absolute;
    top: 0;
    left: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: none;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out-quart);
    will-change: transform, opacity;
  }

  .product3d__stage :global(.product3d__hs-dot) {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 16px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-led-red);
    box-shadow:
      0 0 0 4px rgba(255, 30, 45, 0.16),
      0 0 12px rgba(255, 30, 45, 0.7);
    transition: transform var(--duration-fast) var(--ease-out-quart);
  }

  .product3d__stage :global(.product3d__hs:hover .product3d__hs-dot),
  .product3d__stage :global(.product3d__hs:focus-visible .product3d__hs-dot),
  .product3d__stage :global(.product3d__hs.is-open .product3d__hs-dot) {
    transform: translate(-50%, -50%) scale(1.2);
  }

  .product3d__stage :global(.product3d__hs:focus-visible) {
    outline: none;
  }
  .product3d__stage :global(.product3d__hs:focus-visible .product3d__hs-dot) {
    box-shadow:
      0 0 0 3px var(--color-bg),
      0 0 0 5px var(--color-led-red),
      0 0 12px rgba(255, 30, 45, 0.7);
  }

  /* Onde discrète autour du point (désactivée si mouvement réduit). */
  @media (prefers-reduced-motion: no-preference) {
    .product3d__stage :global(.product3d__hs-dot)::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: 0 0 0 2px rgba(255, 30, 45, 0.55);
      animation: product3d-hs-pulse 2.6s var(--ease-out-quart) infinite;
    }
  }

  @keyframes product3d-hs-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* Info-bulle : au-dessus du point, révélée au survol / focus / clic. */
  .product3d__stage :global(.product3d__hs-card) {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 8px);
    width: max-content;
    max-width: 220px;
    display: grid;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    background: rgba(12, 12, 14, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg, 0 12px 32px rgba(0, 0, 0, 0.5));
    backdrop-filter: blur(8px);
    text-align: left;
    opacity: 0;
    transform: translate(-50%, 4px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-out-quart),
      transform var(--duration-fast) var(--ease-out-quart);
  }

  .product3d__stage :global(.product3d__hs:hover .product3d__hs-card),
  .product3d__stage :global(.product3d__hs:focus-visible .product3d__hs-card),
  .product3d__stage :global(.product3d__hs.is-open .product3d__hs-card) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .product3d__stage :global(.product3d__hs-title) {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .product3d__stage :global(.product3d__hs-text) {
    font-size: var(--text-xs);
    line-height: 1.4;
    color: var(--color-text-secondary);
  }
</style>
