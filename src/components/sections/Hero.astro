---
import { getDictionary } from '../../i18n';
import { SITE } from '../../config/site';
import Button from '../ui/Button.astro';
import lightUrl from '../../assets/models/remolux-light.glb?url';

const t = getDictionary();

// Pose du feu 3D dans le hero — vue légèrement plongeante, zoom bridé, face
// inférieure verrouillée (maxPolarDeg). Chargé progressivement (voir heroProduct.ts).
const heroModel = {
  url: lightUrl,
  azimuthDeg: 20,
  polarDeg: 80,
  distanceScale: 1.6,
  maxPolarDeg: 82,
  maxZoomScale: 1.35,
};
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <canvas class="hero__field" data-hero-field aria-hidden="true"></canvas>
  <div class="hero__grid" data-hero-grid aria-hidden="true"></div>

  <!-- Feu produit : placeholder lumineux instantané, remplacé par la 3D à l'éveil -->
  <div
    class="hero__product"
    data-hero-product
    data-hero-model={JSON.stringify(heroModel)}
    aria-hidden="true"
  >
    <span class="hero__core"></span>
  </div>

  <span class="hero__hud hero__hud--tl" aria-hidden="true"></span>
  <span class="hero__hud hero__hud--tr" aria-hidden="true"></span>
  <span class="hero__hud hero__hud--bl" aria-hidden="true"></span>
  <span class="hero__hud hero__hud--br" aria-hidden="true"></span>

  <div class="hero__inner container">
    <div class="hero__content" data-hero-content>
      <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>

      <h1 class="hero__title" id="hero-title">
        <span class="hero__line">{t.hero.titleLine1}</span>
        <span class="hero__line hero__line--accent">{t.hero.titleLine2}</span>
      </h1>

      <p class="hero__subtitle">{t.hero.subtitle}</p>

      <div class="hero__actions">
        <Button href={SITE.amazonUrl} external>{t.hero.ctaPrimary}</Button>
        <Button href="#vue-3d" variant="ghost">{t.hero.ctaSecondary}</Button>
      </div>

      <ul class="hero__stats" role="list">
        {
          t.hero.stats.map((stat) => (
            <li class="hero__stat">
              <span class="hero__stat-value">{stat.value}</span>
              <span class="hero__stat-label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="hero__hint" aria-hidden="true">{t.hero.scrollHint}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: clip;
    isolation: isolate;
    background: radial-gradient(125% 90% at 70% 40%, #0a0d14 0%, #060709 58%, #030304 100%);
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Grille en perspective : profondeur d'une surface nocturne */
  .hero__grid {
    position: absolute;
    inset: -12% -22% -34% -22%;
    z-index: 1;
    background-image:
      linear-gradient(rgba(180, 200, 230, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(180, 200, 230, 0.08) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(72% 55% at 60% 80%, #000 0%, transparent 72%);
    transform: perspective(700px) rotateX(62deg) translateY(22%)
      translate3d(var(--px, 0), var(--py, 0), 0);
    transform-origin: 50% 100%;
    opacity: 0;
    pointer-events: none;
    will-change: transform;
  }

  /* Feu produit — conteneur du placeholder + de la 3D injectée */
  .hero__product {
    position: absolute;
    z-index: 2;
    top: 46%;
    right: 8%;
    width: min(42vw, 460px);
    aspect-ratio: 1 / 1;
    translate: 0 -50%;
    transform: translate3d(var(--px, 0), var(--py, 0), 0);
    touch-action: pan-y;
    opacity: 0;
    will-change: transform;
  }

  /* Placeholder : cœur lumineux doux (avant l'éveil de la 3D) */
  .hero__core {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 46%,
      rgba(255, 90, 96, 0.6),
      rgba(255, 30, 45, 0.28) 42%,
      transparent 70%
    );
    filter: blur(4px);
    animation: hero-breathe 5.5s ease-in-out infinite;
    transition: opacity 0.6s var(--ease-out-quart);
  }
  .hero__product.is-3d .hero__core {
    opacity: 0;
  }
  .hero__product :global(canvas) {
    opacity: 0;
    transition: opacity 0.7s var(--ease-out-quart);
    cursor: grab;
  }
  .hero__product.is-3d :global(canvas) {
    opacity: 1;
  }
  .hero__product :global(canvas):active {
    cursor: grabbing;
  }

  /* HUD technique */
  .hero__hud {
    position: absolute;
    z-index: 3;
    width: 20px;
    height: 20px;
    border: solid rgba(180, 200, 230, 0.14);
    opacity: 0;
    pointer-events: none;
  }
  .hero__hud--tl {
    top: 84px;
    left: 22px;
    border-width: 1px 0 0 1px;
  }
  .hero__hud--tr {
    top: 84px;
    right: 22px;
    border-width: 1px 1px 0 0;
  }
  .hero__hud--bl {
    bottom: 22px;
    left: 22px;
    border-width: 0 0 1px 1px;
  }
  .hero__hud--br {
    bottom: 22px;
    right: 22px;
    border-width: 0 1px 1px 0;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    min-height: 100svh;
    display: grid;
    align-content: center;
    padding-block: calc(76px + var(--space-8)) var(--space-16);
  }

  .hero__content {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
    transform: translate3d(var(--px, 0), var(--py, 0), 0);
  }

  .hero__eyebrow {
    color: var(--color-text-muted);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
  }
  .hero__line--accent {
    font-weight: 300;
    color: transparent;
    background: linear-gradient(120deg, #cfd8e6, #8b95a6);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero__subtitle {
    max-width: 44ch;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) clamp(var(--space-6), 4vw, var(--space-10));
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .hero__stat {
    display: grid;
    gap: var(--space-1);
  }
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .hero__stat-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__hint {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: var(--space-6);
    translate: -50% 0;
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0;
  }

  /* --- États d'entrée (JS actif) : masqués jusqu'à l'allumage --- */
  :global(html.js) .hero__eyebrow,
  :global(html.js) .hero__line,
  :global(html.js) .hero__subtitle,
  :global(html.js) .hero__actions,
  :global(html.js) .hero__stats {
    opacity: 0;
    transform: translateY(16px);
  }

  /* --- Allumage : révélation échelonnée --- */
  .hero.lit .hero__grid,
  .hero.lit .hero__product,
  .hero.lit .hero__hud,
  .hero.lit .hero__hint {
    opacity: 1;
    transition: opacity 1.2s var(--ease-out-quart);
  }
  .hero.lit .hero__product {
    transition-delay: 0.3s;
  }
  .hero.lit .hero__hud {
    transition-delay: 0.9s;
  }
  .hero.lit .hero__hint {
    transition-delay: 1.1s;
  }

  .hero.lit .hero__eyebrow,
  .hero.lit .hero__line,
  .hero.lit .hero__subtitle,
  .hero.lit .hero__actions,
  .hero.lit .hero__stats {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s var(--ease-out-quart),
      transform 0.9s var(--ease-out-quart);
  }
  .hero.lit .hero__eyebrow {
    transition-delay: 0.45s;
  }
  .hero.lit .hero__line:nth-child(1) {
    transition-delay: 0.58s;
  }
  .hero.lit .hero__line:nth-child(2) {
    transition-delay: 0.7s;
  }
  .hero.lit .hero__subtitle {
    transition-delay: 0.86s;
  }
  .hero.lit .hero__actions {
    transition-delay: 0.98s;
  }
  .hero.lit .hero__stats {
    transition-delay: 1.1s;
  }

  @keyframes hero-breathe {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }

  /* --- Mobile : produit centré en haut, contenu ancré en bas --- */
  @media (max-width: 760px) {
    .hero__product {
      top: 30%;
      right: 50%;
      translate: 50% -50%;
      width: min(72vw, 320px);
    }
    .hero__inner {
      align-content: end;
    }
    .hero__content {
      gap: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__core {
      animation: none;
    }
    .hero__grid,
    .hero__product,
    .hero__hud,
    .hero__eyebrow,
    .hero__line,
    .hero__subtitle,
    .hero__actions,
    .hero__stats {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .hero__hint {
      display: none;
    }
  }
</style>
