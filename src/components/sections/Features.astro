---
import { getDictionary } from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const t = getDictionary();
---

<section class="section features" aria-labelledby="features-title" data-glow-zone>
  <span class="features__glow" data-reactive-glow aria-hidden="true"></span>

  <div class="container features__inner">
    <SectionHeading
      eyebrow={t.features.eyebrow}
      title={t.features.title}
      titleId="features-title"
    />

    <ul class="features__grid" role="list">
      {
        t.features.items.map((item, i) => (
          <li class="features__item" data-reveal data-reveal-delay={String(0.06 * (i % 3))}>
            <span class="features__icon" aria-hidden="true">
              <Icon name={item.icon} />
            </span>
            <h3 class="features__title">{item.title}</h3>
            <p class="features__desc">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    position: relative;
    overflow: clip;
    isolation: isolate;
  }

  /* Halo ambiant réactif (suit le curseur via reactiveGlow). */
  .features__glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      46% 52% at var(--gx, 50%) var(--gy, 16%),
      rgba(255, 30, 45, 0.13),
      transparent 70%
    );
    animation: features-glow-breathe 7s var(--ease-in-out-soft) infinite;
  }

  .features__inner {
    position: relative;
    z-index: 1;
  }

  /* Grille aérée, sans carte : chaque point fort respire sur le fond sombre. */
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(var(--space-8), 4vw, var(--space-12)) var(--space-10);
    margin-top: var(--space-10);
  }

  .features__item {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  /* Nœud LED : icône dans un plot rougeoyant, qui s'intensifie au survol. */
  .features__icon {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: var(--radius-md);
    color: var(--color-led-red);
    background: rgba(255, 30, 45, 0.06);
    border: 1px solid rgba(255, 30, 45, 0.2);
    box-shadow:
      inset 0 0 12px rgba(255, 30, 45, 0.06),
      0 0 10px rgba(255, 30, 45, 0.12);
    margin-bottom: var(--space-2);
    transition:
      box-shadow var(--duration-base) var(--ease-out-quart),
      border-color var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart);
  }

  .features__title {
    position: relative;
    width: fit-content;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  /* Soulignement LED qui se trace au survol. */
  .features__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-led-red);
    box-shadow: 0 0 8px rgba(255, 30, 45, 0.6);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out-expo);
  }

  .features__desc {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
    max-width: 42ch;
  }

  @media (hover: hover) {
    .features__item:hover .features__icon {
      transform: translateY(-2px);
      border-color: rgba(255, 30, 45, 0.5);
      box-shadow:
        inset 0 0 12px rgba(255, 30, 45, 0.12),
        0 0 20px rgba(255, 30, 45, 0.32);
    }
    .features__item:hover .features__title::after {
      transform: scaleX(1);
    }
  }

  @keyframes features-glow-breathe {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .features__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .features__glow {
      animation: none;
    }
  }
</style>
