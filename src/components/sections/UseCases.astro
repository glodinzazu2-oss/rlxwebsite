---
import { Picture } from 'astro:assets';
import { getDictionary } from '../../i18n';
import SectionHeading from '../ui/SectionHeading.astro';
import nautisme from '../../assets/images/situation-nautisme-port-crepuscule.png';
import caravaning from '../../assets/images/situation-caravane-route-soleil.png';
import agricole from '../../assets/images/situation-agricole-champ-boue.png';
import btp from '../../assets/images/situation-btp-porte-engins.png';

const t = getDictionary();

const images = { nautisme, caravaning, agricole, btp } as const;
const items = t.useCases.items.map((item) => ({ ...item, image: images[item.key] }));

/**
 * Points d'allumage LED par scène (coordonnées en % de l'image, sur chaque feu).
 * Un halo est posé sur chaque feu REMOLUX de la mise en situation et s'allume
 * à l'entrée dans le viewport (voir src/scripts/animations/ignite.ts).
 */
const ignitePoints: Partial<Record<(typeof items)[number]['key'], { x: number; y: number }[]>> = {
  nautisme: [
    { x: 58, y: 66 },
    { x: 84, y: 65 },
  ],
  caravaning: [
    { x: 53, y: 64 },
    { x: 84, y: 64 },
  ],
  agricole: [
    { x: 57, y: 57 },
    { x: 83, y: 57 },
  ],
  btp: [
    { x: 63, y: 70 },
    { x: 87, y: 69 },
  ],
};
---

<section class="section usages" aria-labelledby="usages-title">
  <div class="container">
    <SectionHeading eyebrow={t.useCases.eyebrow} title={t.useCases.title} titleId="usages-title" />

    <ul class="usages__grid" role="list">
      {
        items.map((item) => (
          <li class="usages__card">
            <div
              class="usages__media"
              data-tilt
              data-mask-reveal
              data-spotlight
              data-ignite-group={ignitePoints[item.key] ? '' : null}
            >
              <Picture
                src={item.image}
                formats={['avif', 'webp']}
                widths={[480, 760, 1200]}
                sizes="(min-width: 900px) 46vw, 92vw"
                alt={item.alt}
                loading="lazy"
              />
              {(ignitePoints[item.key] ?? []).map((pt) => (
                <span
                  class="ignite"
                  style={`--x: ${pt.x}%; --y: ${pt.y}%;`}
                  data-ignite
                  aria-hidden="true"
                />
              ))}
              <span class="usages__mask" data-mask aria-hidden="true" />
            </div>
            <h3 class="usages__title" data-reveal>
              {item.title}
            </h3>
            <p class="usages__desc" data-reveal data-reveal-delay="0.06">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="usages__disclaimer">{t.useCases.disclaimer}</p>

    <aside class="usages__proof" data-glow-zone data-reveal>
      <span class="usages__proof-glow" data-reactive-glow aria-hidden="true"></span>
      <span class="usages__hud usages__hud--tl" aria-hidden="true"></span>
      <span class="usages__hud usages__hud--br" aria-hidden="true"></span>
      <div class="usages__proof-body">
        <p class="eyebrow usages__proof-eyebrow">{t.useCases.proof.eyebrow}</p>
        <h3 class="usages__proof-title">{t.useCases.proof.title}</h3>
        <p class="usages__proof-caption">{t.useCases.proof.caption}</p>
        <a href="#vue-3d" class="usages__proof-cta">
          {t.useCases.proof.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .usages {
    background:
      radial-gradient(38% 46% at 12% 8%, rgba(255, 30, 45, 0.05), transparent 70%), var(--color-bg);
  }

  .usages__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
    gap: var(--space-6);
  }

  .usages__card {
    display: grid;
    gap: var(--space-2);
  }

  .usages__media {
    position: relative;
    border-radius: var(--radius-md);
    overflow: clip;
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-2);
  }

  .usages__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out-quart);
  }

  /* Halo d'allumage LED, posé sur chaque feu de la scène (voir ignite.ts).
     mix-blend-mode: screen → la lumière s'ajoute à la photo au lieu de la masquer. */
  .ignite {
    /* Positionné en haut-gauche du point ; le centrage (-50%/-50%) et le scale
       sont pilotés par GSAP dans ignite.ts (xPercent/yPercent), car GSAP écrase
       la propriété CSS native `translate`. */
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 17%;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle,
      rgba(255, 30, 45, 0.75) 0%,
      rgba(255, 30, 45, 0.28) 42%,
      transparent 70%
    );
    mix-blend-mode: screen;
    pointer-events: none;
    opacity: 0;
    z-index: 2;
  }

  /* Reflet doux qui suit le curseur sur la surface (spotlight.ts pose --mx/--my). */
  .usages__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(
      30% 40% at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.16),
      transparent 60%
    );
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out-quart);
  }
  .usages__media.is-spot::after {
    opacity: 1;
  }

  /* Masque de révélation : recouvre l'image puis se retire vers le haut au scroll
     (maskReveal.ts). Sans JS / mouvement réduit : rétracté, image visible. */
  .usages__mask {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-bg);
    transform: scaleY(0);
    transform-origin: top;
    pointer-events: none;
  }
  :global(html.js) [data-mask-reveal] .usages__mask {
    transform: scaleY(1);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .usages__card:hover .usages__media :global(img) {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .usages__mask {
      transform: scaleY(0) !important;
    }
  }

  .usages__title {
    font-size: var(--text-lg);
  }

  .usages__desc {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-width: 48ch;
  }

  .usages__disclaimer {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* --- Panneau « transparence » : invite à inspecter le vrai produit en 3D --- */
  .usages__proof {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-top: var(--space-16);
    padding: clamp(var(--space-8), 6vw, var(--space-16));
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0.004));
    text-align: center;
  }

  /* Halo réactif (suit le curseur via reactiveGlow, variables --gx/--gy). */
  .usages__proof-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      42% 55% at var(--gx, 50%) var(--gy, 32%),
      rgba(255, 30, 45, 0.12),
      transparent 70%
    );
    animation: usages-glow-breathe 6s var(--ease-in-out-soft) infinite;
  }

  .usages__hud {
    position: absolute;
    width: 18px;
    height: 18px;
    border: solid rgba(180, 200, 230, 0.18);
    pointer-events: none;
  }
  .usages__hud--tl {
    top: 16px;
    left: 16px;
    border-width: 1px 0 0 1px;
  }
  .usages__hud--br {
    bottom: 16px;
    right: 16px;
    border-width: 0 1px 1px 0;
  }

  .usages__proof-body {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 44rem;
    margin-inline: auto;
  }

  .usages__proof-eyebrow {
    color: var(--color-text-muted);
  }

  .usages__proof-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1rem + 2.6vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .usages__proof-caption {
    margin: 0;
    max-width: 46ch;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .usages__proof-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }
  .usages__proof-cta span {
    color: var(--color-led-red);
    transition: transform var(--duration-fast) var(--ease-out-quart);
  }
  .usages__proof-cta:hover {
    border-color: var(--color-led-red);
  }
  .usages__proof-cta:hover span {
    transform: translateX(4px);
  }
  .usages__proof-cta:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  @keyframes usages-glow-breathe {
    0%,
    100% {
      opacity: 0.65;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .usages__proof-glow {
      animation: none;
    }
    .usages__proof-cta span {
      transition: none;
    }
  }
</style>
